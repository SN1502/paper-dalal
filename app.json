{
  "expo": {
    "name": "PaperDalal",
    "slug": "paper-dalal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paperdalal.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B4CCA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.paperdalal.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F3F4F8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0D13"
          }
        }
      ]
    ],
    "scheme": "paperdalal",
    "backgroundColor": "#F3F4F8",
    "description": "Paper trading for NSE and BSE with live prices, Indian brokerage charges, intraday square-off and after-market orders."
  }
}
